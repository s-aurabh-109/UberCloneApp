# ==========================================
# 1. DEPENDENCIES (Never upload heavy libraries)
# ==========================================
node_modules/
**/node_modules/


# ==========================================
# 2. ENVIRONMENT & SECRETS (Never leak keys)
# ==========================================
.env
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local


# ==========================================
# 3. BUILD OUTPUTS & BUNDLES
# ==========================================
dist/
build/
.next/
out/
*.tsbuildinfo


# ==========================================
# 4. OPERATING SYSTEM & EDITOR JUNK
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
~*

# IDEs & Editors (VS Code, WebStorm, etc.)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp


# ==========================================
# 5. LOGS, DATABASES & RUNTIME CACHES
# ==========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local SQLite or test databases
*.sqlite
*.db
*.sqlite3


# ==========================================
# 6. TESTING & COVERAGE REPORTS
# ==========================================
coverage/
.nyc_output/